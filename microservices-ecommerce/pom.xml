<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>com.ecommerce</groupId>
    <artifactId>microservices-ecommerce</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Ferrestore dependency baseline</name>
    <modules>
        <module>config-server</module>
        <module>discovery-server</module>
        <module>api-gateway</module>
        <module>product-service</module>
        <module>inventory-service</module>
        <module>order-service</module>
        <module>payment-service</module>
        <module>notification-service</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>3.1.1</springdoc.version>
        <mercadopago.version>3.7.0</mercadopago.version>
        <cloudinary.version>2.5.0</cloudinary.version>
        <!-- Security overrides: Boot 4.1.2 still manages AMQP client 5.30.0. -->
        <rabbit-amqp-client.version>5.37.0</rabbit-amqp-client.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <legacy-httpclient.version>4.5.14</legacy-httpclient.version>
        <error-prone-annotations.version>2.48.0</error-prone-annotations.version>
        <hk2.version>4.0.3</hk2.version>
        <!-- Springdoc needs Jackson 2.22; 2.22.3 fixes its current CVEs. -->
        <jackson-2-bom.version>2.22.3</jackson-2-bom.version>
        <gson.version>2.14.0</gson.version>
        <!-- Instrumentation 2.28 targets the OTel 1.62 API managed by Boot 4.1.2. -->
        <opentelemetry-instrumentation.version>2.28.0-alpha</opentelemetry-instrumentation.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>${error-prone-annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>org.glassfish.hk2</groupId>
                <artifactId>hk2-bom</artifactId>
                <version>${hk2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>${commons-beanutils.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${legacy-httpclient.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mercadopago</groupId>
                <artifactId>sdk-java</artifactId>
                <version>${mercadopago.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cloudinary</groupId>
                <artifactId>cloudinary-http5</artifactId>
                <version>${cloudinary.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>dependency-security-baseline</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21.0.13,22)</version>
                                    <message>Use a patched JDK 21.0.13 or newer within Java 21, including the eMudhra certificate fix. Both compilation and runtime use Java 21.</message>
                                </requireJavaVersion>
                                <requireMavenVersion><version>[3.9.16,)</version></requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <requireUpperBoundDeps/>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework.cloud:spring-cloud-config-server:(,5.0.5)</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-gateway-server:(,5.0.3)</exclude>
                                        <exclude>org.springframework.cloud:spring-cloud-commons:(,5.0.3)</exclude>
                                        <exclude>org.springframework.security:*:(,7.1.1)</exclude>
                                        <exclude>com.cloudinary:cloudinary-http44</exclude>
                                        <exclude>com.cloudinary:cloudinary-core:(,2.3.0)</exclude>
                                        <exclude>com.mercadopago:sdk-java:(,3.7.0)</exclude>
                                        <exclude>com.rabbitmq:amqp-client:(,5.36.1)</exclude>
                                        <exclude>commons-beanutils:commons-beanutils:(,1.11.0)</exclude>
                                        <exclude>org.apache.httpcomponents:httpclient:(,4.5.14)</exclude>
                                        <exclude>com.fasterxml.jackson.core:jackson-core:(,2.22.3)</exclude>
                                        <exclude>com.fasterxml.jackson.core:jackson-databind:(,2.22.3)</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.3</version>
                <configuration>
                    <outputFormat>json</outputFormat>
                    <includeTestScope>false</includeTestScope>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <outputName>bom</outputName>
                </configuration>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>security-sbom</id>
                        <phase>verify</phase>
                        <goals><goal>makeBom</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
